# =============================================================
# Agentic Fraud Detection - Environment Variables
# =============================================================
# Copy this to .env and fill in your values:  cp .env.example .env

# --- LLM (for investigation agents) ---
# Set LLM_PROVIDER to 'gemini' (free) or 'openai' (paid). Default: auto-detect.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-your-openai-key-if-you-have-one

# --- AWS (for DynamoDB + S3) ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# --- Langfuse (observability) ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App Config ---
FRAUD_THRESHOLD_AUTO_APPROVE=0.2
FRAUD_THRESHOLD_AUTO_BLOCK=0.8
MODEL_PATH=ml/models/fraud_xgboost.pkl
